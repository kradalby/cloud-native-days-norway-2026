use flake

secret_env -v <<'SECRETS'
  GIGAHOST_TOKEN  gigahost/demo/api-token
SECRETS

# kradalby/gigahost is not on the OpenTofu registry: the flake builds it into
# GIGAHOST_PROVIDER_MIRROR. Delete once it is on the registry.
# Each build platform has its own checksum in live/.terraform.lock.hcl: a new
# one needs `tofu providers lock` (acts/0-prep, step 2).
mkdir -p "$PWD/.direnv"
cat >"$PWD/.direnv/tofurc" <<EOF
provider_installation {
  filesystem_mirror {
    path    = "$GIGAHOST_PROVIDER_MIRROR"
    include = ["registry.opentofu.org/kradalby/gigahost"]
  }
  direct {
    exclude = ["registry.opentofu.org/kradalby/gigahost"]
  }
}
EOF
export TF_CLI_CONFIG_FILE=$PWD/.direnv/tofurc
